{
  "Version": "2012-10-17",
  "Statement": [{
    "Sid": "AllowAgentCoreToAssume",
    "Effect": "Allow",
    "Principal": { "Service": "bedrock-agentcore.amazonaws.com" },
    "Action": "sts:AssumeRole",
    "Condition": {
      "StringEquals": { "aws:SourceAccount": "603011031216" },
      "ArnLike": { "aws:SourceArn": "arn:aws:bedrock-agentcore:us-east-1:603011031216:*" }
    }
  }]
}
